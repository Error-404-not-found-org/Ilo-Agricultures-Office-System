{
  "cli": {
    "version": ">= 14.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },

    "production-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    },

    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production"
    }
  },

  "submit": {
    "production": {}
  }
}
